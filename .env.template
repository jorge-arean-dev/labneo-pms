# PMS Environment Variables Template
# Copy this file to .env.local and fill in your values
#
# For new client deployments, see: app-builder/REPLICATION-GUIDE.md

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these from: Supabase Dashboard > Settings > API

# Project URL (e.g., https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon/Public key - safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Publishable key - same as anon key for most projects
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service Role key - KEEP SECRET! Server-side only
# Never expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# SITE URL (Optional)
# =============================================================================
# Usually auto-detected on Vercel. Set manually for:
# - Local development with specific URLs
# - Custom domain configurations
# - Email redirect URLs

# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# =============================================================================
# SECURITY KEYS (Required)
# =============================================================================
# These must be generated for each deployment

# Encryption key for SMTP passwords stored in database
# Generate with: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=

# Secret for authenticating cron job requests (email reminders)
# Generate with: openssl rand -hex 16
# Must match the value in cron_config table
CRON_SECRET=

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# Email settings are configured via the app's admin interface (Settings > Email)
# The SMTP password is encrypted using EMAIL_ENCRYPTION_KEY above

# Legacy SMTP variables (not used - kept for reference)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@your-domain.com

# =============================================================================
# INTEGRATIONS (Optional)
# =============================================================================
# WhatsApp bot integration via n8n
# N8N_API_KEY=your-n8n-api-key

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
#
# Local Development:
#   1. Copy this file: cp .env.template .env.local
#   2. Fill in Supabase credentials
#   3. Run: pnpm dev
#
# Vercel Deployment:
#   1. Add these variables in Vercel Dashboard > Settings > Environment Variables
#   2. Redeploy after adding variables
#
# Security Reminders:
#   - Never commit .env.local to git
#   - SUPABASE_SERVICE_ROLE_KEY is sensitive - keep it secret
#   - Use different Supabase projects for dev/staging/prod
